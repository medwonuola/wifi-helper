# Copy to .env (in this folder, or ~/.config/wifi-helper/env) and fill in.
# `wifi config` shows which file is loaded; `wifi doctor` suggests values.

# The Huawei HiLink modem / 5G CPE. Huawei's default is 192.168.8.1.
MODEM_URL=http://192.168.8.1
MODEM_USER=admin
MODEM_PASSWORD=

# Optional: a separate Wi-Fi router between you and the modem (e.g. Huawei AX3/AX3S).
# Leave ROUTER_URL empty if your devices connect to the modem's own Wi-Fi.
ROUTER_URL=
ROUTER_USER=admin
ROUTER_PASSWORD=

# Safety: the tool only touches devices when your default gateway is one of these.
# Defaults to the router and modem addresses above.
# ALLOWED_GATEWAYS=192.168.3.1,192.168.8.1

# Stronger safety: pin your gateway's MAC so a different network that happens to use
# the same address (very common with Huawei's defaults) is never touched.
# `wifi doctor` prints the right value.
# HOME_GATEWAY_MAC=aa:bb:cc:dd:ee:ff

# Optional exact Wi-Fi names. Ignored when the OS hides the SSID.
# ALLOWED_SSIDS=My Home WiFi,My Home WiFi 5G

# Watchdog tuning
CHECK_INTERVAL=15
OFFLINE_CHECKS_BEFORE_FIX=2
REBOOT_COOLDOWN=900
